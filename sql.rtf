\f0\fs24 \cf0 -- 1. \uc0\u26082 \u23384 \u12398 \u12486 \u12540 \u12502 \u12523 \u12539 \u12509 \u12522 \u12471 \u12540 \u12398 \u12522 \u12475 \u12483 \u12488 \u65288 \u37325 \u35079 \u38450 \u27490 \u65289 \
drop table if exists public.votes cascade;\
drop table if exists public.user_reputations cascade;\
drop table if exists public.threads cascade;\
drop table if exists public.banned_users cascade;\
\
-- ==============================================================================\
-- 2. \uc0\u12486 \u12540 \u12502 \u12523 \u20316 \u25104 \
-- ==============================================================================\
\
-- 2-1. BAN\uc0\u12518 \u12540 \u12470 \u12540 \u31649 \u29702 \u12486 \u12540 \u12502 \u12523 \
create table public.banned_users (\
    fp text primary key,\
    reason text default '\uc0\u35215 \u32004 \u36949 \u21453 ',\
    created_at timestamp with time zone default timezone('utc'::text, now()) not null\
);\
\
-- 2-2. \uc0\u12473 \u12524 \u12483 \u12489 \u31649 \u29702 \u12486 \u12540 \u12502 \u12523 \
create table public.threads (\
    id text primary key,\
    title text not null,\
    author text default '\uc0\u21517 \u28961 \u12375 ',\
    body text not null,\
    img text,\
    tags text[] default array[]::text[],\
    fp text not null,\
    created_at timestamp with time zone default timezone('utc'::text, now()) not null,\
    up_count integer default 0 not null,\
    down_count integer default 0 not null,\
    replies jsonb default '[]'::jsonb not null\
);\
\
-- 2-3. \uc0\u12473 \u12524 \u12483 \u12489 \u35413 \u20385 \u65288 Good/Bad\u65289 \u12398 \u20108 \u37325 \u25237 \u31080 \u38450 \u27490 \u12486 \u12540 \u12502 \u12523 \
create table public.votes (\
    id bigint generated by default as identity primary key,\
    thread_id text not null references public.threads(id) on delete cascade,\
    fp text not null,\
    vote_type text not null check (vote_type in ('up', 'down')),\
    created_at timestamp with time zone default timezone('utc'::text, now()) not null,\
    unique(thread_id, fp)\
);\
\
-- 2-4. \uc0\u20491 \u20154 \u65288 \u12518 \u12540 \u12470 \u12540 FP\u65289 \u12395 \u23550 \u12377 \u12427 \u35413 \u20385 \u12486 \u12540 \u12502 \u12523 \
create table public.user_reputations (\
    id bigint generated by default as identity primary key,\
    target_fp text not null,\
    voter_fp text not null,\
    vote_type text not null check (vote_type in ('up', 'down')),\
    created_at timestamp with time zone default timezone('utc'::text, now()) not null,\
    unique(target_fp, voter_fp)\
);\
\
-- ==============================================================================\
-- 3. \uc0\u12452 \u12531 \u12487 \u12483 \u12463 \u12473 \u20316 \u25104 \u65288 \u26908 \u32034 \u12539 \u20006 \u12403 \u26367 \u12360 \u12398 \u39640 \u36895 \u21270 \u65289 \
-- ==============================================================================\
create index idx_threads_created_at on public.threads (created_at desc);\
create index idx_threads_fp on public.threads (fp);\
create index idx_votes_thread_id on public.votes (thread_id);\
create index idx_user_reputations_target on public.user_reputations (target_fp);\
\
-- ==============================================================================\
-- 4. RLS\uc0\u65288 Row Level Security / \u12450 \u12463 \u12475 \u12473 \u21046 \u24481 \u65289 \u12398 \u35373 \u23450 \
-- ==============================================================================\
\
-- 4-1. banned_users \uc0\u12398 \u12475 \u12461 \u12517 \u12522 \u12486 \u12451 \
alter table public.banned_users enable row level security;\
create policy "BAN\uc0\u12522 \u12473 \u12488 \u12399 \u35504 \u12391 \u12418 \u21442 \u29031 \u21487 \u33021 " on public.banned_users for select using (true);\
create policy "BAN\uc0\u12522 \u12473 \u12488 \u12398 \u36861 \u21152 \u26356 \u26032 \u12399 \u31649 \u29702 \u32773 \u12398 \u12415 " on public.banned_users for insert with check (false);\
\
-- 4-2. threads \uc0\u12398 \u12475 \u12461 \u12517 \u12522 \u12486 \u12451 \u65288 BAN\u12518 \u12540 \u12470 \u12540 \u12398 \u25237 \u31295 \u25298 \u21542 \u65289 \
alter table public.threads enable row level security;\
create policy "\uc0\u12473 \u12524 \u12483 \u12489 \u12399 \u35504 \u12391 \u12418 \u38322 \u35239 \u21487 \u33021 " on public.threads for select using (true);\
create policy "BAN\uc0\u12373 \u12428 \u12390 \u12356 \u12394 \u12356 \u12518 \u12540 \u12470 \u12540 \u12398 \u12415 \u12473 \u12524 \u12483 \u12489 \u20316 \u25104 \u21487 \u33021 " on public.threads for insert \
with check (\
    not exists (\
        select 1 from public.banned_users where banned_users.fp = threads.fp\
    )\
);\
create policy "\uc0\u35504 \u12391 \u12418 \u36820 \u20449 \u12420 \u35413 \u20385 \u25968 \u12398 \u26356 \u26032 \u12364 \u21487 \u33021 " on public.threads for update \
using (true) \
with check (\
    not exists (\
        select 1 from public.banned_users where banned_users.fp = threads.fp\
    )\
);\
\
-- 4-3. votes \uc0\u12398 \u12475 \u12461 \u12517 \u12522 \u12486 \u12451 \
alter table public.votes enable row level security;\
create policy "\uc0\u25237 \u31080 \u12487 \u12540 \u12479 \u12399 \u35504 \u12391 \u12418 \u38322 \u35239 \u21487 \u33021 " on public.votes for select using (true);\
create policy "\uc0\u35504 \u12391 \u12418 \u25237 \u31080 \u21487 \u33021 " on public.votes for insert with check (true);\
\
-- 4-4. user_reputations \uc0\u12398 \u12475 \u12461 \u12517 \u12522 \u12486 \u12451 \
alter table public.user_reputations enable row level security;\
create policy "\uc0\u20491 \u20154 \u35413 \u20385 \u12399 \u35504 \u12391 \u12418 \u38322 \u35239 \u21487 \u33021 " on public.user_reputations for select using (true);\
create policy "\uc0\u35504 \u12391 \u12418 \u20491 \u20154 \u35413 \u20385 \u21487 \u33021 " on public.user_reputations for insert with check (true);\
\
-- ==============================================================================\
-- 5. Realtime\uc0\u65288 \u12522 \u12450 \u12523 \u12479 \u12452 \u12512 \u21516 \u26399 \u65289 \u12398 \u26377 \u21177 \u21270 \
-- ==============================================================================\
alter publication supabase_realtime add table public.threads;}